{
  "name": "DVORAK Device Mapping",
  "description": "KeyMouse Dvorak layout - physical keys mapped to action names",
  "leftHand": {
    "soundButtons": {
      "upper": [
        { "key": "'", "action": "left_hand_sound_upper_pinky" },
        { "key": ",", "action": "left_hand_sound_upper_ring" },
        { "key": ".", "action": "left_hand_sound_upper_middle" },
        { "key": "p", "action": "left_hand_sound_upper_index" }
      ],
      "home": [
        { "key": "a", "action": "left_hand_sound_home_pinky" },
        { "key": "o", "action": "left_hand_sound_home_ring" },
        { "key": "e", "action": "left_hand_sound_home_middle" },
        { "key": "u", "action": "left_hand_sound_home_index" }
      ],
      "lower": [
        { "key": ";", "action": "left_hand_sound_lower_pinky" },
        { "key": "q", "action": "left_hand_sound_lower_ring" },
        { "key": "j", "action": "left_hand_sound_lower_middle" },
        { "key": "k", "action": "left_hand_sound_lower_index" }
      ]
    },
    "octaveButtons": {
      "increase": { "key": "4", "action": "left_hand_increase_octave" },
      "decrease": { "key": "3", "action": "left_hand_decrease_octave" }
    }
  },
  "rightHand": {
    "soundButtons": {
      "upper": [
        { "key": "g", "action": "right_hand_sound_upper_index" },
        { "key": "c", "action": "right_hand_sound_upper_middle" },
        { "key": "r", "action": "right_hand_sound_upper_ring" },
        { "key": "l", "action": "right_hand_sound_upper_pinky" }
      ],
      "home": [
        { "key": "h", "action": "right_hand_sound_home_index" },
        { "key": "t", "action": "right_hand_sound_home_middle" },
        { "key": "n", "action": "right_hand_sound_home_ring" },
        { "key": "s", "action": "right_hand_sound_home_pinky" }
      ],
      "lower": [
        { "key": "m", "action": "right_hand_sound_lower_index" },
        { "key": "w", "action": "right_hand_sound_lower_middle" },
        { "key": "v", "action": "right_hand_sound_lower_ring" },
        { "key": "z", "action": "right_hand_sound_lower_pinky" }
      ]
    },
    "octaveButtons": {
      "increase": { "key": "7", "action": "right_hand_increase_octave" },
      "decrease": { "key": "8", "action": "right_hand_decrease_octave" }
    }
  },
  "global": {
    "settings": [
      { "key": "Escape", "action": "open_settings" },
      { "key": "]", "action": "toggle_actions_list" }
    ],
    "playback": [
      { "key": "\\", "action": "panic_stop" },
      { "key": "/", "action": "toggle_metronome" }
    ]
  }
}
